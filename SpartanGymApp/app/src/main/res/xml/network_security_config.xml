<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Politica de red centralizada de Spartan Gym.
        La configuración base corresponde a producción: solo HTTPS.
        La variante debug reemplaza este archivo para permitir la API local.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
