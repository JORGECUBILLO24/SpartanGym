# Plantilla de configuracion del web. Copiar a .env y ajustar si hace falta:
#
#   cp SpartanGymWeb/.env.example SpartanGymWeb/.env
#
# El .env real NO se versiona (esta en .gitignore) para que nadie suba por accidente
# una credencial al repo compartido. Ojo: todo lo que empiece con VITE_ queda visible
# en el bundle que se sirve al navegador, asi que aca NUNCA van secretos —
# solo configuracion publica como esta URL.

# API que consume el web. En produccion apunta a Render.
# Para desarrollo local contra la API en tu PC: http://localhost:8080/api
VITE_API_BASE_URL=https://spartangym-api.onrender.com/api
